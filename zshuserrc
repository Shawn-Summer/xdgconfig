# ssh 
##  在ssh退出的时候确保禁用mouse reporting中的转义序列的发送
ssht() {
    ssh "$@"
    local rc=$?
    printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l'
    return $rc

}

export LC_SSH_IDENTITY=xxl #用于ssh验证身份

