auto-update = off

# apperance
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

font-family = "Maple Mono NF CN Regular"
font-style-bold="Maple Mono NF CN Bold"
font-style-bold-italic = "Maple Mono NF CN Bold Italic"
font-style-italic ="Maple Mono NF CN Italic"
font-size=12
font-thicken = true

background-opacity=0.6
background-opacity-cells = true
background-blur = true
macos-titlebar-style = tabs 
macos-icon = holographic

cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true

# recover the state 
window-save-state = default
window-inherit-working-directory = true
window-inherit-font-size = true

# select auto copy to system clipboard
copy-on-select = clipboard

# never confirm
confirm-close-surface = false
# shell-integration
shell-integration = detect
## copy local terminfo into the remote host
shell-integration-features = ssh-terminfo,ssh-env

# shader

custom-shader = ./shaders/cursor_blaze.glsl
# custom-shader = ./shaders/myshader1.glsl
custom-shader-animation = true 
